# Data never goes in the repo (public sources; see README).
# The folder skeleton and its READMEs are tracked so users know where files go.
data/**
!data/**/
!data/**/README.md
*.csv
*.dta
*.sas7bdat
*.sas7bcat
*.xlsx
*.zip
*.parquet

# Outputs are regenerated
output/

# R session files
.Rhistory
.RData
.Rproj.user/
*.Rproj
.Rdata

# SAS / Stata logs
*.log
*.lst
*.smcl
*.stswp

# OS
.DS_Store
Thumbs.db
desktop.ini
